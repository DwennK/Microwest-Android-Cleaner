{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Microwest Android Cleaner",
  "version": "2.1.1",
  "identifier": "ch.microwest.android-cleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Microwest · Android Cleaner",
        "width": 1440,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Microwest",
    "shortDescription": "Diagnostic Android pour techniciens",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../adb/": "adb/",
      "../tools/aapt2.exe": "tools/aapt2.exe",
      "../tools/aapt2-NOTICE.txt": "tools/aapt2-NOTICE.txt",
      "../tools/apksigner.jar": "tools/apksigner.jar",
      "../tools/apksigner-NOTICE.txt": "tools/apksigner-NOTICE.txt",
      "../tools/jre/": "tools/jre/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBQTJCOTIxNDIyQjVBQzEKUldUQldpdENJYm1paWg5VmtKbmZQU1ZQNE5rZGVxaDlBQXo2WXVBZC9GeVNRMWZwNzFvYmxhTEoK",
      "endpoints": [
        "https://github.com/DwennK/Microwest-Android-Cleaner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
